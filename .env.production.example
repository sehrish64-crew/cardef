# Production Environment Variables Template
# Copy this file to .env.production on your server and fill real values.

# Base URL for your domain
NEXT_PUBLIC_BASE_URL=https://carreaders.com

# Node Environment
NODE_ENV=production

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_USER=your_db_user
DB_PASSWORD=[REDACTED]
DB_NAME=your_db_name
DB_PORT=3306


SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@example.com
SMTP_PASS=[REDACTED]
EMAIL_FROM="YourSite <no-reply@example.com>"

# Debug / Feature flags
ENABLE_DB_CHECK=false
