# Production Environment Variables Template
# Copy this file to .env.production on your server and fill real values.

# Base URL for your domain
NEXT_PUBLIC_BASE_URL=https://example.com

# Node Environment
NODE_ENV=production

# Database Configuration (MySQL)
DB_HOST=mysql.your-host-host
DB_USER=your_db_user
DB_PASSWORD=[REDACTED]
DB_NAME=your_db_name
DB_PORT=3306

# Email Configuration (SMTP) — use App Passwords for Gmail or provider creds
# For Gmail: Use port 465 with SMTP_SECURE=true
# If 2FA is enabled, create an App Password at: https://myaccount.google.com/apppasswords
# Test locally before deploying: node scripts/test-smtp.js
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=sender@example.com
SMTP_PASS=[REDACTED]
EMAIL_FROM="YourSite <no-reply@example.com>"

# Optional: Resend API (recommended for deliverability)
RESEND_API_KEY=

# Optional third-party API keys
AUTO_DEV_API_KEY=

# Debug / Feature flags
ENABLE_DB_CHECK=false
