NEXT_PUBLIC_BASE_URL=https://carreaders.com
NODE_ENV=production
PORT=3000
DB_HOST=mysql.your-hostinger-host
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=your_db_name
DB_PORT=3306

# SMTP (for sending emails)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=your_smtp_user
# SMTP_PASSWORD=your_smtp_password
# SMTP_FROM=noreply@carreaders.com

# VIN / 3rd-party API keys
# AUTO_DEV_API_KEY=your_vin_api_key

# Optional analytics & features
# NEXT_PUBLIC_GA_ID=UA-XXXXX-Y
# NEXT_PUBLIC_ENABLE_CHAT=false
# NEXT_PUBLIC_ENABLE_REVIEWS=true

# Security: don't commit real secrets. Instead set them in Hostinger Panel
# or place a real `.env` file on the server (outside public_html) and restart the app.
